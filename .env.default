# =========================
# Discord Bot Configuration
# =========================

# Discord bot token
DISCORD_TOKEN=
# Discord user ID of the bot owner
OWNER_ID=
# GitHub repository link
GITHUB_REPO=

# =========================
# Database Configuration
# =========================

# Path to the SQLite database file
SQLITE_DB=data/lancobot.db

# =========================
# Database Backup Settings
# =========================

# Directory for database backups
DATABASE_BACKUP_DIRECTORY=data/backups
# Backup filename pattern
DATABASE_BACKUP_FILENAME=lancobot_backup_{}.db
# Backup interval in seconds (default: 86400 = 24 hours)
DATABASE_BACKUP_INTERVAL=86400
# Number of backups to retain
DATABASE_BACKUP_RETENTION=7

# =========================
# Bot Settings
# =========================

# Number of messages to cache
MESSAGE_CACHE_SIZE=1000

# Deployment environment, and the single source of truth for which dotenv file
# is loaded (.env.<BOT_ENV>, falling back to .env), whether hot-reload and debug
# logging are on, and the environment reported to Elastic APM.
#   poetry run dev   -> BOT_ENV=dev   -> loads .env.dev
#   poetry run prod  -> BOT_ENV=prod  -> loads .env.prod
#   docker-compose   -> BOT_ENV=prod by default; override it in the .env next
#                       to docker-compose.yml to run that stack as dev
# A value in the real process environment outranks one in a file, so a stale
# value here cannot demote a dev run to production.
BOT_ENV=prod
# Legacy alias for BOT_ENV=dev; still works, but prefer BOT_ENV. Rewritten at
# startup to match whatever BOT_ENV resolved to.
DEV_MODE=false
# Port for the embedded web server, which starts with the webserver cog and
# serves /health. Blacklist the cog to disable it entirely.
WEBSERVER_PORT=8080
# Bearer token guarding the detailed /status endpoint. Leave empty to keep
# /status disabled; /health is always public and exposes nothing sensitive.
WEBSERVER_TOKEN=

# =========================
# Logging
# =========================

# Root log level override (DEBUG, INFO, WARNING, ERROR).
# Defaults to DEBUG in dev mode and INFO otherwise.
# Set LOG_LEVEL=INFO to hide debug output when running poetry run dev.
LOG_LEVEL=

# Logtail logging token (optional)
LOGTAIL_TOKEN=

# Path to an ECS-formatted JSON log file for a shipper (Filebeat, Elastic Agent)
# to tail into Elasticsearch. Empty disables it. The human-readable
# logs/logfile.log is written either way; this is a second file in JSON, one
# document per line, carrying service and trace fields so Kibana can link a log
# line to the APM transaction that produced it.
# Set this to logs/lancobot.ecs.json when running the filebeat sidecar.
ECS_LOG_FILE=

# Elasticsearch, for the filebeat logging sidecar only (see
# docker-compose.logging.yml). Separate from the APM credentials above: APM
# Server and Elasticsearch are different endpoints.
ELASTICSEARCH_HOST=
# API key in Filebeat's "id:api_key" form, from Kibana > Stack Management >
# API keys. Needs write access to the logs-* data streams.
ELASTICSEARCH_API_KEY=

# Elastic APM error tracking (optional). Enabled only when SERVER_URL is set.
# APM Server URL (e.g. https://<id>.apm.<region>.cloud.es.io:443)
ELASTIC_APM_SERVER_URL=
# Auth: set one (token for Elastic Cloud, API key otherwise)
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_API_KEY=
# Service name in the APM UI (defaults to "lanco-bot")
ELASTIC_APM_SERVICE_NAME=lanco-bot
# Environment shown in the APM UI. Leave empty to inherit BOT_ENV, which is
# what keeps dev and prod data separate in Kibana.
ELASTIC_APM_ENVIRONMENT=
# Send one synthetic error on startup to prove the pipeline works end to end.
# Defaults to on in dev and off in prod, so production does not file a fake
# error on every deploy. Set to true temporarily when verifying prod wiring.
ELASTIC_APM_STARTUP_TEST=

# Dev mode only: comma-separated list of cog names to show console log output for.
# All other cog loggers are suppressed on the console (still written to log file).
# Example: LOG_COGS=geoguesser,incidents
LOG_COGS=

# =========================
# Development
# =========================

# Comma-separated list of cog directory names to load exclusively.
# When set, only the listed cogs are loaded — all others are skipped.
# Useful for faster startup during development.
# Example: COG_WHITELIST=geoguesser
COG_WHITELIST=

# Comma-separated list of cog directory names to skip on startup. Ignored if COG_WHITELIST is set.
# Example: COG_BLACKLIST=honeybot,triviasniper
COG_BLACKLIST=

# =========================
# API Keys
# =========================

# Google Maps API key
GMAPS_API_KEY=

# OpenWeatherMap API key
OPENWEATHERMAP_API_KEY=
# OpenCage Geocoding API key
OPENCAGE_API_KEY=

# Spotify client ID
SPOTIFY_CLIENT_ID=
# Spotify client secret
SPOTIFY_SECRET=

# OpenAI API key
OPENAI_API_KEY=
# OpenAI Admin API key — requires api.usage.read scope (used by the tokenusage cog)
OPENAI_ADMIN_KEY=
# OpenAI project ID to scope usage queries to this project only
OPENAI_PROJECT_ID=
# Wolfram Alpha API key
WOLFRAM_ALPHA_API_KEY=
# VirusTotal API key
VIRUS_TOTAL_API_KEY=
# YouTube Data API key
YOUTUBE_API_KEY=

# =========================
# Third-party Integrations
# =========================

# Everbridge
EVERBRIDGE_USERNAME=
EVERBRIDGE_PASSWORD=

# Google Calendar API key
GOOGLE_CAL_API_KEY=

# Sightengine
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Truth Social
TRUTH_SOCIAL_USERNAME=
TRUTH_SOCIAL_PASSWORD=
